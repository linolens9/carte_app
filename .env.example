APP_NAME='MBOLO'
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Libreville
APP_URL=http://localhost/carte_app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carte_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=1800

# Configuration Envoi d'Emails (SMTP / mail / log)
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@carteapp.ga
MAIL_FROM_NAME="MBOLO Carte App"

# Configuration WhatsApp (direct / cloud_api / log)
WHATSAPP_DRIVER=direct
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Configuration SMS classique (direct / gateway / log)
SMS_DRIVER=direct
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID="MBOLO"
